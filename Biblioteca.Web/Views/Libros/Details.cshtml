@model Biblioteca.Web.Models.Libro
@{
    ViewData["Title"] = "Detalle de libro";
}

<h1>@Model.Titulo</h1>

<dl class="row">
    <dt class="col-sm-2">Autor</dt>
    <dd class="col-sm-10">@Model.AutorNombre</dd>
    <dt class="col-sm-2">Año</dt>
    <dd class="col-sm-10">@Model.Anio</dd>
    <dt class="col-sm-2">Ejemplares</dt>
    <dd class="col-sm-10">@Model.Ejemplares</dd>
</dl>

<a class="btn btn-secondary" asp-action="Index">Volver</a>
