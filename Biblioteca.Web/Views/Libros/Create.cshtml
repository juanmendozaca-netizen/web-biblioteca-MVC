@model Biblioteca.Web.Models.Libro
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = ViewData["Title"] ?? "Crear libro";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Título</label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Autor</label>
        <select asp-for="AutorId" class="form-select" asp-items="@(ViewData["Autores"] as SelectList)"></select>
        <span asp-validation-for="AutorId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Año</label>
        <input asp-for="Anio" class="form-control" />
        <span asp-validation-for="Anio" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Ejemplares</label>
        <input asp-for="Ejemplares" class="form-control" />
        <span asp-validation-for="Ejemplares" class="text-danger"></span>
    </div>
    <button class="btn btn-primary" type="submit">Guardar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
