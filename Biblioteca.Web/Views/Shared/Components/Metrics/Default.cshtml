@model Biblioteca.Web.Models.MetricsViewModel

<div class="container mb-3">
    <div class="row g-3 align-items-stretch">
        <div class="col-md-3">
            <a asp-controller="Libros" asp-action="Index" class="text-decoration-none text-reset">
                <div class="card text-center border-primary h-100">
                    <div class="card-body">
                        <h6 class="card-title"><i class="fas fa-book me-2"></i>Libros</h6>
                        <p class="display-6 m-0">@Model.LibrosActivos</p>
                        <p class="small text-muted">Activos</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Socios" asp-action="Index" class="text-decoration-none text-reset">
                <div class="card text-center border-success h-100">
                    <div class="card-body">
                        <h6 class="card-title"><i class="fas fa-users me-2"></i>Socios</h6>
                        <p class="display-6 m-0">@Model.SociosActivos</p>
                        <p class="small text-muted">Activos</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-warning h-100">
                <div class="card-body">
                    <h6 class="card-title"><i class="fas fa-hand-holding-heart me-2"></i>Préstamos</h6>
                    <p class="display-6 m-0">@Model.PrestamosActivos</p>
                    <p class="small text-muted">Activos</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-danger h-100">
                <div class="card-body">
                    <h6 class="card-title"><i class="fas fa-exclamation-triangle me-2"></i>Vencidos</h6>
                    <p class="display-6 m-0">@Model.PrestamosVencidos</p>
                    <p class="small text-muted">Préstamos vencidos</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">Préstamos últimos meses</h6>
                    <canvas id="metricsChart" height="80"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function(){
            var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MesesLabels ?? new string[0]));
            var data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MesesCounts ?? new int[0]));
            var ctx = document.getElementById('metricsChart');
            if (ctx) {
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Préstamos',
                            data: data,
                            borderColor: '#0d6efd',
                            backgroundColor: 'rgba(13,110,253,0.12)',
                            tension: 0.3,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, precision:0 } }
                    }
                });
            }
        })();
    </script>
}
